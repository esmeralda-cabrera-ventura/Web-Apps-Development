{
  "Version": "2012-10-17",
  "Id": "esmeraldaspace-website-policy",
  "Statement": [
    {
      "Sid": "AllowCloudFrontToReadEverything",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::046049464914:distribution/YOUR-DISTRIBUTION-ID"
        }
      }
    },
    {
      "Sid": "AllowPublicDirectReadOfVerificationPages",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::YOUR-BUCKET-NAME/verified.html",
        "arn:aws:s3:::YOUR-BUCKET-NAME/not-verified.html"
      ]
    }
  ]
}
